# Copy values into your local process environment or the hosting platform's
# server-side secrets/settings. This file is a template and is not auto-loaded.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# SQLite is created/migrated by server/database.ts. Use a writable persistent
# path for local use. A container's local disk is not durable across restarts.
CONEXA_DB_PATH=

# General assistant: Gemini only; disabled unless explicitly enabled and keyed.
AI_ENABLED=false
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
AI_MAX_OUTPUT_TOKENS=512
AI_REQUEST_TIMEOUT_MS=30000
AI_HISTORY_LIMIT=12

# Password reset email is unavailable until all three values are configured.
RESEND_API_KEY=
CONEXA_EMAIL_FROM=
APP_URL=

# Optional map services. Blank values keep server-side search/routing disabled.
MAP_GEOCODING_URL=
MAPS_CONTACT_URL=
MAP_ROUTING_URL=

# Optional TURN server. Secrets must remain server-side.
TURN_URL=
TURN_SECRET=

# Optional server-side MuPDF executable override.
MUTOOL_PATH=

# Optional local PC gateway, configured separately from the web app.
CONEXA_GATEWAY_HOST=0.0.0.0
CONEXA_GATEWAY_PORT=8765
CONEXA_GATEWAY_DIAGNOSTICS_PORT=8766
CONEXA_GATEWAY_DISCOVERY_PORT=8767
CONEXA_GATEWAY_DATABASE=
CONEXA_GATEWAY_SECRET=
